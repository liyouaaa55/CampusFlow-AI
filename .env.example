# ============================================================
# CampusFlow AI 环境变量模板
#
# 使用方法：复制本文件为 .env，再填入真实值。
#
# ⚠️ 安全提醒（务必阅读）
#   1) .env 已被 .gitignore 忽略，禁止把真实 Key 提交到仓库；
#   2) 本文件（.env.example）会被提交进仓库，只允许放占位符，
#      任何时候都不允许把真实 API Key 写在这里；
#   3) 部署到 Streamlit Cloud 时，请把 Key 配置在
#      Settings → Secrets（不要写进代码、也不要用本文件）。
#
# 配置优先级：Streamlit Secrets > .env > 代码默认值
# ============================================================

# 大模型 API Key（示例为占位符，请替换为真实值）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址（OpenAI 兼容协议）
# 硅基流动：https://api.siliconflow.cn/v1
# DeepSeek 官方：https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1

# 模型 ID
# 硅基流动示例：deepseek-ai/DeepSeek-V4-Flash
# DeepSeek 官方示例：deepseek-chat
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 调试开关：1 开启 LLM 原始返回日志排错，0 关闭（提交/演示前请置 0）
CAMPUSFLOW_DEBUG=0
